# llm/prompts.py — NPC system prompts (combat)
# =========================================================================

msgid "healthy"
msgstr "здоров"

msgid "badly wounded"
msgstr "тяжело ранен"

msgid "wounded"
msgstr "ранен"

msgid "Around you:"
