msgstr "Нельзя выбрать себя целью для '{action}'."

msgid "'{action}' can only target hostile creatures."
msgstr "Целью '{action}' могут быть только враждебные существа."

msgid "'{action}' can only target allies."
msgstr "Целью '{action}' могут быть только союзники."

msgid "Travel requires a destination"
msgstr "Для путешествия нужен пункт назначения"

msgid "No route to destination"
msgstr "Нет пути к пункту назначения"

msgid "Already at destination"
msgstr "Уже в пункте назначения"

msgid "Cannot rest while in combat"
msgstr "Нельзя отдыхать во время боя"

# API boundary bounds (WS message size, action params)
msgid "Message too large (limit {} bytes)"
msgstr "Сообщение слишком большое (предел {} байт)"

msgid "Action params must be a JSON object"
msgstr "Параметры действия должны быть JSON-объектом"

msgid "Action params are too large"
msgstr "Параметры действия слишком большие"
