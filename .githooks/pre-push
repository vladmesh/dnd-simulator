#!/bin/bash
# Pre-push hook: full local gate (make check) must pass before pushing.
# Mirrors CI (backend + frontend lint/typecheck/tests); integration runs in
# CI and at /close-phase, not here (too heavy for a hook).

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if ! command -v uv &> /dev/null; then
    echo "uv not found. Install: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

if ! command -v npx &> /dev/null; then
    echo "node/npx not found — required for frontend checks (make check). Install Node 18+ and run 'cd frontend && npm ci'."
    exit 1
fi

echo "Running pre-push checks (make check)..."

if ! make check; then
    echo "Checks failed. Fix before pushing."
    exit 1
fi

echo "All checks passed."
